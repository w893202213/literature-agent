# ============ 文献综述自动化 Agent 环境变量模板 ============
# 使用方法：复制本文件为 .env 并填写真实值。.env 已被 .gitignore 排除，绝不提交。

# ---- 主力 LLM API（中科大，OpenAI 兼容）----
OPENAI_BASE_URL=https://api.llm.ustc.edu.cn/v1
OPENAI_API_KEY=sk-your-ustc-key
MODEL=deepseek-v4-flash-ascend   # 按实际可用模型调整（GET /v1/models 可查）

# ---- 备用 LLM API（限流/降级时自动切换；New API 网关）----
FALLBACK_BASE_URL=https://op.ibbbb.top:8887/v1
FALLBACK_API_KEY=sk-your-gateway-key
FALLBACK_MODEL=deepseek-v4-pro

# ---- Semantic Scholar API（可选，注册免费 key 后限流大幅放宽）----
# 注册：https://www.semanticscholar.org/product/api
S2_API_KEY=

# ---- ArXiv API ----
# 若直连出口被 arXiv 限流（HTTP 429，NAT 共享 IP 常见），可走本地代理（Clash 默认端口 7897）
ARXIV_PROXY=http://127.0.0.1:7897

# ---- OpenAlex API（搜索主通道，无 key）----
# mailto 进"礼貌池"：显著提升限流配额（OpenAlex 官方推荐，用真实邮箱）
OPENALEX_MAILTO=your@school.edu.cn

# ---- LLM 采样参数 ----
LLM_TEMPERATURE=0.2        # 结构化提取用低温，保证 JSON 稳定

# ---- 网络 ----
# 默认 false：强制直连（trust_env=False），避免系统代理（Clash）不可用时 TLS 超时
# 若某 API 必须走代理，改为 true
USE_PROXY=false
